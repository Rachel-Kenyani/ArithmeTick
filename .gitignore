# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# test coverage
coverage/

# macOS
.DS_Store
*.pem

# local env files (secrets stay out of git)
.env
.env*.local

# typescript
*.tsbuildinfo

# editors / tools (shared .claude/settings.json is kept; personal overrides are not)
.idea/
.claude/


# Generated native projects (Continuous Native Generation: npx expo prebuild)
/ios
/android

AGENTS.md
docs/
assets/voice
sonar-project.properties

# Supabase CLI cache and local secrets (the pooler URL names the database host)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/functions/.env
supabase/functions/**/.env

# Signing keys, store credentials and app builds
*.keystore
credentials.json
google-services.json
GoogleService-Info.plist
*service-account*.json
*.apk
*.aab
*.ipa
