{
  "expo": {
    "name": "ArithmeTick",
    "slug": "arithmetick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixeledge.arithmetick"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D2EFEC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pixeledge.arithmetick"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D2EFEC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 346
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "scheme": "arithmetick",
    "experiments": {
      "typedRoutes": true
    }
  }
}
