    {
      "name": "6. SMS (Edge Function + Africa's Talking)",
      "item": [
        {
          "name": "send-sms hook (test directly)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Signs the body like Supabase does (Standard Webhooks), so the function accepts it.",
                  "const secret = pm.variables.get('smsHookSecret').replace('v1,whsec_', '');",
                  "const id = 'msg_' + Date.now();",
                  "const ts = Math.floor(Date.now() / 1000).toString();",
                  "const body = pm.request.body.raw.replace(/{{(\\w+)}}/g, (_, k) => pm.variables.get(k));",
                  "const sig = CryptoJS.HmacSHA256(`${id}.${ts}.${body}`, CryptoJS.enc.Base64.parse(secret)).toString(CryptoJS.enc.Base64);",
                  "pm.request.headers.upsert({ key: 'webhook-id', value: id });",
                  "pm.request.headers.upsert({ key: 'webhook-timestamp', value: ts });",
                  "pm.request.headers.upsert({ key: 'webhook-signature', value: 'v1,' + sig });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/functions/v1/send-sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "functions",
                "v1",
                "send-sms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"phone\": \"{{phoneDigits}}\"\n  },\n  \"sms\": {\n    \"otp\": \"123456\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Calls the deployed Edge Function the way Supabase's Send SMS hook does, so you can test Africa's Talking without signing up. Needs `smsHookSecret` (the v1,whsec_\u2026 secret from Auth \u2192 Hooks). Expect `{}` and the SMS in the Africa's Talking simulator."
          }
        },
        {
          "name": "Africa's Talking: send SMS (sandbox)",
          "request": {
