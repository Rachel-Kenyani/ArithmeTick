              "path": [
                "auth",
                "v1",
                "otp"
              ]
            },
            "description": "Forgot Password with a phone: Supabase has no reset-by-SMS, so this texts a sign-in code (no new account). Then use \"Verify SMS code\" from folder 2.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"create_user\": false\n}",
              "options": {
