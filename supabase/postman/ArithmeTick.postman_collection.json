        {
          "name": "Auth settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "settings"
              ]
            },
            "description": "Which sign-in methods are on (email, phone, google) and whether confirmations are required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
