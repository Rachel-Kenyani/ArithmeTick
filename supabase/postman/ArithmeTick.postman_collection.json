{
  "info": {
    "_postman_id": "5381cf89-6e82-49aa-985a-7a4433d61768",
    "name": "ArithmeTick API",
    "description": "Every backend call the ArithmeTick app makes: Supabase Auth (email/phone sign-up with 6-digit codes, log in, forgot password, Google), the `send-sms` Edge Function (Supabase Send SMS hook) and Africa's Talking.\n\nSetup: import `ArithmeTick.postman_environment.json`, fill in `baseUrl` + `anonKey` (the same values as the app's .env) and the test email/phone. Verify and log-in requests save `accessToken` automatically.\n\nSecrets (Africa's Talking key, hook secret) belong in the environment's *current value* only, never in the shared collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Email: sign up, verify, log in",
      "item": [
        {
          "name": "Sign up (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "signup"
              ]
            },
            "description": "Create Account with email. Supabase emails a 6-digit code (Confirm signup template). App: auth.signUp.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend sign-up code (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "resend"
              ]
            },
            "description": "\"Resend Code\" on Verify Account. App: auth.resendCode.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"signup\",\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify sign-up code (email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "verify"
              ]
            },
            "description": "Put the emailed code in the `otp` variable first. Returns a session. App: auth.verifyCode (type signup).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"signup\",\n  \"email\": \"{{email}}\",\n  \"token\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', data.refresh_token || '');",
                  "  console.log('Saved accessToken for the signed-in user');",
                  "}",
                  "pm.test('Status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in (email + password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/token?grant_type=password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Log In To Account. App: auth.logIn.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', data.refresh_token || '');",
                  "  console.log('Saved accessToken for the signed-in user');",
                  "}",
                  "pm.test('Status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
