    {
      "name": "4. Google",
      "item": [
        {
          "name": "Sign in with Google ID token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/token?grant_type=id_token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "id_token"
                }
              ]
            },
            "description": "\"Continue with Google\" (Log In and Create Account). The app gets `idToken` from the native Google picker; paste one into `googleIdToken` to test. Creates the account the first time. App: services/googleAuth.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"id_token\": \"{{googleIdToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', data.refresh_token || '');",
                  "  console.log('Saved accessToken for the signed-in user');",
                  "}",
                  "pm.test('Status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
